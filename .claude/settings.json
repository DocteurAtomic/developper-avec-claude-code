{
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(PACHAPLAN_DB=data/pachaplan.sqlite uv run pytest:*)",
      "Skill(relances)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Read(./.env)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/ruff_after_edit.py"
            ]
          }
        ]
      }
    ]
  }
}
