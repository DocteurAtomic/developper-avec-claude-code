+"""Trainers on duty next week, Monday to Friday, day by day, with the warnings.
+
+Runs the trainer board of `pachaplan trainers --date DAY` for each working day of
+the week that follows the reference date. Reads the database read-only.
+
+    uv run python .claude/skills/trainers-week/scripts/trainers_week.py
+        [--today YYYY-MM-DD] [--db PATH]
+
+Exit codes: 0 on success, 1 when the database cannot be opened, 2 on a usage error.
+"""
+
+import argparse
+import os
+import sys
+from datetime import date, timedelta
+
+from pachaplan import planning
+from pachaplan.db import connect, resolve_path
+
+WORKING_DAYS = 5
+
+
+def parse_args(argv):
+    parser = argparse.ArgumentParser(prog="trainers-week", description=__doc__.splitlines()[0])
+    parser.add_argument("--today", help="reference date (default: $PACHAPLAN_TODAY, then today)")
+    parser.add_argument("--db", help="database (default: $PACHAPLAN_DB, then the data/ file)")
+    args = parser.parse_args(argv)
+    text = args.today or os.environ.get("PACHAPLAN_TODAY")
+    try:
+        args.today = planning.parse_day(text) if text else date.today()
+    except ValueError:
+        parser.error(f"invalid date {text!r}, expected YYYY-MM-DD")
+    return args
+
+
+def next_week(today):
+    """The Monday to Friday of the week after the one of `today`."""
+    monday = today + timedelta(days=7 - today.weekday())
+    return [monday + timedelta(days=n) for n in range(WORKING_DAYS)]
+
+
+def main(argv=None):
+    args = parse_args(argv)
+    days = next_week(args.today)
+    try:
+        conn = connect(resolve_path(args.db))
+    except FileNotFoundError as exc:
+        print(f"trainers-week: {exc}", file=sys.stderr)
+        return 1
+    with conn:
+        results = [planning.assign_trainers(conn, day) for day in days]
+
+    print(
+        f"Trainers on duty from {days[0].isoformat()} to {days[-1].isoformat()} "
+        f"(reference date {args.today.isoformat()})"
+    )
+    week = list(zip(days, results, strict=True))
+    for day, result in week:
+        print(f"\n=== {day.strftime('%A')} {day.isoformat()} ===")
+        planning.print_trainer_day(result)
+
+    total = sum(len(r["warnings"]) for r in results)
+    per_day = ", ".join(f"{d.isoformat()}: {len(r['warnings'])}" for d, r in week)
+    print(f"\nWeek: {total} warning(s) ({per_day}).")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
