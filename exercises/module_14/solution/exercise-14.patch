+"""Tests of the script of the `trainers-week` skill (.claude/skills/trainers-week)."""
+
+import importlib.util
+import os
+import sqlite3
+import subprocess
+import sys
+from datetime import date
+from pathlib import Path
+
+import pytest
+
+SCRIPT = (
+    Path(__file__).parents[1]
+    / ".claude"
+    / "skills"
+    / "trainers-week"
+    / "scripts"
+    / "trainers_week.py"
+)
+
+
+def run(db_path, *args, env=None):
+    return subprocess.run(
+        [sys.executable, str(SCRIPT), "--db", str(db_path), *args],
+        capture_output=True,
+        text=True,
+        env=env,
+    )
+
+
+def load_script():
+    spec = importlib.util.spec_from_file_location("trainers_week_script", SCRIPT)
+    script = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(script)
+    return script
+
+
+@pytest.mark.parametrize(
+    "today",
+    ["2026-11-02", "2026-11-06", "2026-11-07", "2026-11-08"],
+)
+def test_next_week_is_the_monday_to_friday_after_the_reference_date(today):
+    days = load_script().next_week(date.fromisoformat(today))
+    assert [d.isoformat() for d in days] == [
+        "2026-11-09",
+        "2026-11-10",
+        "2026-11-11",
+        "2026-11-12",
+        "2026-11-13",
+    ]
+
+
+def test_trainers_week_lists_each_working_day(db_path):
+    result = run(db_path, "--today", "2026-11-06")
+    assert result.returncode == 0, result.stderr
+    lines = result.stdout.splitlines()
+    assert lines[0] == "Trainers on duty from 2026-11-09 to 2026-11-13 (reference date 2026-11-06)"
+    headers = [line for line in lines if line.startswith("=== ")]
+    assert headers == [
+        "=== Monday 2026-11-09 ===",
+        "=== Tuesday 2026-11-10 ===",
+        "=== Wednesday 2026-11-11 ===",
+        "=== Thursday 2026-11-12 ===",
+        "=== Friday 2026-11-13 ===",
+    ]
+    assert "No session on 2026-11-09." in lines
+    tuesday = lines[lines.index(headers[1]) : lines.index(headers[2])]
+    assert any(line.startswith("Julie Lambert  101 ") for line in tuesday)
+    friday = lines[lines.index(headers[4]) :]
+    assert any(line.startswith("Paul Girard  102 ") for line in friday)
+    assert lines[-1].startswith("Week: 0 warning(s) (")
+
+
+def test_trainers_week_shows_the_warnings_of_the_day(db_path):
+    conn = sqlite3.connect(db_path)
+    conn.execute(
+        "INSERT INTO session (session_id, course_id, language_code, room_id, trainer_id, "
+        "start_date, duration_days, status_code, is_in_house, created_on) "
+        "VALUES (302, 1, 'FR', 1, NULL, '2026-11-12', 1, 'CONFIRMED', 0, '2026-06-01')"
+    )
+    conn.commit()
+    conn.close()
+    result = run(db_path, "--today", "2026-11-06")
+    assert result.returncode == 0, result.stderr
+    lines = result.stdout.splitlines()
+    thursday = lines[lines.index("=== Thursday 2026-11-12 ===") :]
+    thursday = thursday[: thursday.index("=== Friday 2026-11-13 ===")]
+    assert "  - session 302: no trainer assigned" in thursday
+    assert lines[-1].startswith("Week: 1 warning(s) (")
+    assert "2026-11-12: 1" in lines[-1]
+
+
+def test_trainers_week_uses_pachaplan_today(db_path):
+    env = {**os.environ, "PACHAPLAN_TODAY": "2026-11-13"}
+    result = run(db_path, env=env)
+    assert result.returncode == 0, result.stderr
+    first = result.stdout.splitlines()[0]
+    assert first == "Trainers on duty from 2026-11-16 to 2026-11-20 (reference date 2026-11-13)"
