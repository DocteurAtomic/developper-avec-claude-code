{
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "uv",
          "args": ["run", "--project", "${CLAUDE_PROJECT_DIR}", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/no_push.py"]
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "uv",
          "args": ["run", "--project", "${CLAUDE_PROJECT_DIR}", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/tests_before_stop.py"],
          "timeout": 300
        }
      ]
    }
  ]
}
