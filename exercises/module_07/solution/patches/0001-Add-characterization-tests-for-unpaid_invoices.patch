diff --git a/tests/test_unpaid_characterization.py b/tests/test_unpaid_characterization.py
new file mode 100644
index 0000000..7a26328
--- /dev/null
+++ b/tests/test_unpaid_characterization.py
@@ -0,0 +1,332 @@
+"""Characterization tests of unpaid_invoices on the test database.
+
+They pin what the function returns today, right or wrong, so that a refactoring
+can be checked against it. They do not say the current output is correct: when
+one of them fails, decide whether the change of behaviour is wanted before
+updating the expected value.
+
+The first tests use tests/fixture.sql as it is. The fixture only has two unpaid
+invoices, so the scenario tests add rows to the temporary copy of it (never to
+fixture.sql itself) to reach every reminder level, every kind of customer and
+the edges of the cutoff and of the settled tolerance.
+
+Totals are sums of floats: they are compared with pytest.approx, so that a
+change in the order of the additions does not count as a change of behaviour.
+"""
+
+import sqlite3
+from datetime import date
+
+import pytest
+from conftest import TODAY
+
+from pachaplan.db import connect
+from pachaplan.planning import unpaid_invoices
+
+FA2 = {
+    "invoice_code": "FA2",
+    "invoice_date": "2026-09-15",
+    "due_date": "2026-10-15",
+    "age": 48,
+    "days_late": 18,
+    "customer": "Hugo Fabre",
+    "course": "SQL: getting started",
+    "trainees": ["Hugo Fabre"],
+    "gross": 600,
+    "paid": 0,
+    "credited": 0,
+    "balance": 600,
+    "reminders": "first reminder sent",
+    "action": "send second reminder",
+}
+
+FA4 = {
+    "invoice_code": "FA4",
+    "invoice_date": "2026-10-20",
+    "due_date": "2026-11-19",
+    "age": 13,
+    "days_late": -17,
+    "customer": "Durand Industries",
+    "course": "SQL: getting started",
+    "trainees": ["Claire Martin"],
+    "gross": 360,
+    "paid": 0,
+    "credited": 0,
+    "balance": 360,
+    "reminders": "none sent",
+    "action": "wait (not due yet)",
+}
+
+
+def totals(count, gross, paid=0, credited=0):
+    return {
+        "count": count,
+        "gross": gross,
+        "paid": paid,
+        "credited": credited,
+        "balance": gross + credited - paid,
+    }
+
+
+def assert_result(result, rows, totals, top_customers, cutoff):
+    assert result["rows"] == rows
+    assert result["totals"] == pytest.approx(totals)
+    assert [name for name, _ in result["top_customers"]] == [name for name, _ in top_customers]
+    assert [amount for _, amount in result["top_customers"]] == pytest.approx(
+        [amount for _, amount in top_customers]
+    )
+    assert result["cutoff"] == cutoff
+    assert set(result) == {"rows", "totals", "top_customers", "cutoff"}
+
+
+# ---------------------------------------------------------------------------
+# The fixture as it is
+# ---------------------------------------------------------------------------
+
+
+def test_fixture_30_days(conn):
+    # FA1 paid, FA3 canceled by AV1, FA4 issued after the cutoff.
+    assert_result(
+        unpaid_invoices(conn, TODAY, 30),
+        rows=[FA2],
+        totals=totals(1, 600),
+        top_customers=[("Hugo Fabre", 600)],
+        cutoff="2026-10-03",
+    )
+
+
+def test_fixture_10_days(conn):
