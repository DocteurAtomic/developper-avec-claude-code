+"""Characterization tests of unpaid_invoices on the real database. Set PACHAPLAN_DB to run them.
+
+Each snapshot in tests/snapshots/unpaid_invoices/ is what the function returned
+for data/pachaplan.sqlite on that day with that number of days, right or wrong,
+when the snapshot was written. A failure means the output changed: decide
+whether the change is wanted before rewriting the snapshot.
+
+The snapshots are JSON, so the (name, amount) pairs of top_customers are stored
+as lists. Totals and customer amounts are sums of floats and are compared with
+pytest.approx; the rows are compared exactly.
+"""
+
+import json
+import os
+from datetime import date
+from pathlib import Path
+
+import pytest
+
+from pachaplan.db import connect
+from pachaplan.planning import unpaid_invoices
+
+SNAPSHOTS = Path(__file__).with_name("snapshots") / "unpaid_invoices"
+
+# 2026-11-02, 30 days: the usual report, every action but a plain "wait".
+# 2026-06-30, 90 days: a long delay, almost everything handed over to collections.
+# 2026-03-15, 15 days: a short delay, with invoices not due yet and some to wait for.
+CASES = [("2026-11-02", 30), ("2026-06-30", 90), ("2026-03-15", 15)]
+
+
+@pytest.fixture(scope="module")
+def real_conn():
+    path = os.environ.get("PACHAPLAN_DB")
+    if not path:
+        pytest.skip("PACHAPLAN_DB is not set")
+    c = connect(path)
+    yield c
+    c.close()
+
+
+@pytest.mark.parametrize("day, days", CASES)
+def test_unpaid_matches_snapshot(real_conn, day, days):
+    snapshot = SNAPSHOTS / f"{day}_{days}d.json"
+    expected = json.loads(snapshot.read_text(encoding="utf-8"))
+    result = unpaid_invoices(real_conn, date.fromisoformat(day), days)
+
+    assert result["cutoff"] == expected["cutoff"]
+    assert result["rows"] == expected["rows"]
+    assert result["totals"] == pytest.approx(expected["totals"])
+    assert [name for name, _ in result["top_customers"]] == [
+        name for name, _ in expected["top_customers"]
+    ]
+    assert [amount for _, amount in result["top_customers"]] == pytest.approx(
+        [amount for _, amount in expected["top_customers"]]
+    )
+    assert set(result) == set(expected)
