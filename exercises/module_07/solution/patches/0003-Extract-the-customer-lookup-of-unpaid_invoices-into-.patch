+def invoice_customer(conn, inv):
+    """Who owes it: the company when there is one, otherwise the person."""
+    if inv["company_id"] is not None:
+        return scalar(conn, f"SELECT name FROM company WHERE company_id = {inv['company_id']}")
+    if inv["contact_id"] is not None:
+        person = query(
+            conn,
+            f"SELECT first_name, last_name FROM contact WHERE contact_id = {inv['contact_id']}",
+        )
+        return full_name(person[0]["first_name"], person[0]["last_name"]) if person else "?"
+    return "?"
