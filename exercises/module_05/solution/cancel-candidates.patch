 # Sessions starting within this many days are "upcoming" for the fill report.
 HORIZON_DAYS = 30
 
+# Sessions starting within this many days, bounds included, are checked for cancellation.
+CANCEL_WINDOW_DAYS = 15
+
+# A session filled strictly under this percentage may have to be canceled.
+CANCEL_BELOW_PCT = 40
+
 # Statuses of a session that is still going to happen.
 ACTIVE_STATUSES = ("PLANNED", "OPEN", "CONFIRMED")
 
@@ -209,6 +217,44 @@ def print_low_fill(rows, below, today, out=sys.stdout):
     )
 
 
+# ---------------------------------------------------------------------------
+# Sessions that may have to be canceled
+# ---------------------------------------------------------------------------
+
+
+def cancel_candidates(conn, today):
+    """Sessions starting in the cancel window and filled strictly under CANCEL_BELOW_PCT.
+
+    Ordered by start date, then session id, as returned by upcoming_sessions.
+    """
+    result = []
+    for s in upcoming_sessions(conn, today, CANCEL_WINDOW_DAYS):
+        enrolled = count_enrollments(conn, s["session_id"])
+        capacity = s["max_attendees"]
+        rate = 100.0 * enrolled / capacity if capacity else 0.0
+        if rate < CANCEL_BELOW_PCT:
+            result.append(
+                {
+                    "session_id": s["session_id"],
+                    "start_date": s["start_date"],
+                    "title": s["title"],
+                    "enrolled": enrolled,
+                    "capacity": capacity,
+                }
+            )
+    return result
+
+
+def print_cancel_candidates(rows, out=sys.stdout):
+    """One line per session, id;date;title;enrolled;capacity, nothing else."""
+    for r in rows:
+        title = r["title"].replace(";", ",")
+        print(
+            f"{r['session_id']};{r['start_date']};{title};{r['enrolled']};{r['capacity']}",
+            file=out,
+        )
+
+
 # ---------------------------------------------------------------------------
 # Trainers on a given day
 # ---------------------------------------------------------------------------
diff --git a/tests/test_cancel.py b/tests/test_cancel.py
new file mode 100644
index 0000000..454439d
--- /dev/null
+++ b/tests/test_cancel.py
@@ -0,0 +1,90 @@
+import io
+
+from conftest import TODAY
+
+from pachaplan.cli import main
+from pachaplan.db import connect
+from pachaplan.planning import cancel_candidates, print_cancel_candidates
+
+
+def add_session(db_path, session_id, start_date, active=0, waiting=0, canceled=0):
+    """Add a session of course 1 (10 seats) with the given enrollments to the test copy."""
+    conn = connect(db_path, readonly=False)
+    conn.execute(
+        "INSERT INTO session VALUES (?, 1, 'FR', 1, 1, NULL, ?, 2, 1500, NULL, 'OPEN', 0, NULL,"
+        " '2026-06-01')",
+        (session_id, start_date),
+    )
+    kinds = [(None, 0)] * active + [(None, 1)] * waiting + [("2026-10-01", 0)] * canceled
+    for i, (cancellation_date, waiting_list) in enumerate(kinds):
+        conn.execute(
+            "INSERT INTO enrollment VALUES (?, ?, 1, '2026-09-01 10:00:00', ?, 0, 0, ?, NULL)",
+            (session_id * 100 + i, session_id, cancellation_date, waiting_list),
+        )
+    conn.commit()
+    conn.close()
+
+
+def candidate_ids(db_path):
+    conn = connect(db_path)
+    rows = cancel_candidates(conn, TODAY)
+    conn.close()
+    return [r["session_id"] for r in rows]
+
+
+def test_cancel_candidates_on_the_fixture(conn):
+    rows = cancel_candidates(conn, TODAY)
+    assert [r["session_id"] for r in rows] == [101]
+    assert rows[0]["enrolled"] == 2
+    assert rows[0]["capacity"] == 10
+
+
+def test_cancel_window_bounds_are_inclusive(db_path):
+    add_session(db_path, 201, "2026-11-01")
+    add_session(db_path, 202, "2026-11-02")
+    add_session(db_path, 203, "2026-11-17")
+    add_session(db_path, 204, "2026-11-18")
+    assert candidate_ids(db_path) == [202, 101, 203]
+
+
+def test_cancel_threshold_is_strict(db_path):
+    add_session(db_path, 201, "2026-11-05", active=4)
+    add_session(db_path, 202, "2026-11-05", active=3)
+    assert candidate_ids(db_path) == [202, 101]
+
+
+def test_cancel_ignores_waiting_list_and_canceled_enrollments(db_path):
+    add_session(db_path, 201, "2026-11-05", active=3, waiting=1, canceled=1)
+    conn = connect(db_path)
+    rows = cancel_candidates(conn, TODAY)
+    conn.close()
+    assert {r["session_id"]: r["enrolled"] for r in rows} == {201: 3, 101: 2}
+
+
+def test_cancel_sorted_by_date_then_id(db_path):
+    add_session(db_path, 302, "2026-11-08")
+    add_session(db_path, 301, "2026-11-08")
+    add_session(db_path, 303, "2026-11-04")
+    assert candidate_ids(db_path) == [303, 301, 302, 101]
+
+
+def test_print_cancel_candidates_format(conn):
+    out = io.StringIO()
+    print_cancel_candidates(cancel_candidates(conn, TODAY), out)
+    assert out.getvalue() == "101;2026-11-10;SQL: getting started;2;10\n"
+
+    out = io.StringIO()
+    row = {"session_id": 9, "start_date": "2026-11-03", "title": "A; B", "enrolled": 0,
+           "capacity": 4}
+    print_cancel_candidates([row], out)
+    assert out.getvalue() == "9;2026-11-03;A, B;0;4\n"
+
+
+def test_cli_cancel_candidates(db_path, capsys):
+    code = main(["--db", str(db_path), "--today", "2026-11-02", "cancel-candidates"])
+    assert code == 0
+    assert capsys.readouterr().out == "101;2026-11-10;SQL: getting started;2;10\n"
+
+    code = main(["--db", str(db_path), "--today", "2027-06-01", "cancel-candidates"])
+    assert code == 0
+    assert capsys.readouterr().out == ""
